configuration {
  display-drun: " Run: ";
  display-window: "Windows: ";
  drun-display-format: "{icon} {name}";
  modi: "window,run,drun";
  font: "TerminessNerdFont Bold 32";
  show-icons: true;
  icon-theme: "Papirus";
}

@theme "/dev/null"

* {
  red      : #de524a;
  lred     : #ff7162;
  green    : #22d87a;
  lgreen   : #c9ee5e;
  yellow   : #ecc747;
  lyellow  : #edd682;
  blue     : #2366c3;
  lblue    : #7fb4ff;
  magenta  : #9132e8;
  lmagenta : #c17fff;
  cyan     : #55e7f0;
  lcyan    : #a7ecef;

  white    : #e5e9e6;
  black    : #130912;

  bg: @black;
  fg: @lgreen;

  disabled : #5d5d5d;

  background-color: @bg;

  margin: 0;
  padding: 0;
  spacing: 0;
}

window {
  width: 50%;
  height: 47%;
  padding: 50;

  border: 2;
  border-color: @lgreen;
}

element {
  padding: 28;
  text-color: @fg;
}

element selected {
  text-color: @fg;
  border: 2;
  border-color: @lgreen;
}

element-text {
  background-color: #00000000;
  text-color: inherit;
  vertical-align: 0.5;
}

element-icon {
  size: 40;
}

entry {
  background-color: @bg;
  padding: 12;
  text-color: @fg;

  margin-bottom: 50;
}

prompt {
  background-color: @lgreen;
  padding: 12;
  text-color: @bg;
  margin-bottom: 50;
}

inputbar {
  children: [prompt, entry];
}

listview {
  background-color: @bg;
  columns: 2;
  lines: 8;
}
